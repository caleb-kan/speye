{
  "name": "speye-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run license:gen && vite",
    "prebuild": "npm run license:gen && npm run icons:gen",
    "build": "tsc -b && vite build",
    "license:gen": "bash scripts/generate-licenses.sh",
    "icons:gen": "node scripts/generate-pwa-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "node --test scripts/apply-patches.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node scripts/apply-patches.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs": "^4.22.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.57.0",
    "nouislider": "^15.8.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "regression": "^2.0.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@tensorflow/tfjs": {
      "argparse": "^2.0.1"
    },
    "minimatch": "^10.2.1",
    "serialize-javascript": "^7.0.5"
  }
}
